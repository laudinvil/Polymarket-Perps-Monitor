{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polymarket-perps-monitor",
  "main": "worker.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR",
        "class_name": "MonitorState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MonitorState"]
    }
  ]
}
